# ─────────── Runtime ───────────
NODE_ENV=development

# ─────────── Ports ───────────
GATEWAY_PORT=3000
AUTH_PORT=3001
JOB_PORT=3002
CVAPP_PORT=3003
AI_PORT=3004
NOTIF_PORT=3005

# ─────────── Internal service URLs (used by gateway + inter-service calls) ───────────
AUTH_SERVICE_URL=http://localhost:3001
JOB_SERVICE_URL=http://localhost:3002
CVAPP_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004
NOTIF_SERVICE_URL=http://localhost:3005

# ─────────── Database (single PostgreSQL, schema-per-service) ───────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=nexhire

# ─────────── Redis (BullMQ queues + token store) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────── JWT (separate secrets for access vs refresh) ───────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ─────────── MinIO (object storage for CV files) ───────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexhire

# ─────────── SMTP (email) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexHire <noreply@nexhire.vn>"

# ─────────── AI (Gemini) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────── Frontend ───────────
FRONTEND_URL=http://localhost:5173
