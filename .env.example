# Runtime
NODE_ENV=development

# Ports
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CANDIDATE_SERVICE_PORT=3002
COMPANY_SERVICE_PORT=3003
JOB_SERVICE_PORT=3004
APPLICATION_SERVICE_PORT=3005
CV_PARSING_SERVICE_PORT=3006
MATCHING_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
DOCUMENT_STORAGE_SERVICE_PORT=3009

# Internal service URLs
AUTH_SERVICE_URL=http://localhost:3001
CANDIDATE_SERVICE_URL=http://localhost:3002
COMPANY_SERVICE_URL=http://localhost:3003
JOB_SERVICE_URL=http://localhost:3004
APPLICATION_SERVICE_URL=http://localhost:3005
CV_PARSING_SERVICE_URL=http://localhost:3006
MATCHING_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
DOCUMENT_STORAGE_SERVICE_URL=http://localhost:3009
CANDIDATE_SERVICE_HTTP_TIMEOUT_MS=30000
CV_PARSING_SERVICE_HTTP_TIMEOUT_MS=30000
JOB_SERVICE_HTTP_TIMEOUT_MS=5000
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# Database
DB_HOST=localhost
DB_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AUTH_SERVICE_DB_NAME=auth_service_db
AUTH_SERVICE_DB_USER=auth_service_user
AUTH_SERVICE_DB_PASS=auth_service_pass
CANDIDATE_SERVICE_DB_NAME=candidate_service_db
CANDIDATE_SERVICE_DB_USER=candidate_service_user
CANDIDATE_SERVICE_DB_PASS=candidate_service_pass
COMPANY_SERVICE_DB_NAME=company_service_db
COMPANY_SERVICE_DB_USER=company_service_user
COMPANY_SERVICE_DB_PASS=company_service_pass
JOB_SERVICE_DB_NAME=job_service_db
JOB_SERVICE_DB_USER=job_service_user
JOB_SERVICE_DB_PASS=job_service_pass
APPLICATION_SERVICE_DB_NAME=application_service_db
APPLICATION_SERVICE_DB_USER=application_service_user
APPLICATION_SERVICE_DB_PASS=application_service_pass
CV_PARSING_SERVICE_DB_NAME=cv_parsing_service_db
CV_PARSING_SERVICE_DB_USER=cv_parsing_service_user
CV_PARSING_SERVICE_DB_PASS=cv_parsing_service_pass
MATCHING_SERVICE_DB_NAME=matching_service_db
MATCHING_SERVICE_DB_USER=matching_service_user
MATCHING_SERVICE_DB_PASS=matching_service_pass
NOTIFICATION_SERVICE_DB_NAME=notification_service_db
NOTIFICATION_SERVICE_DB_USER=notification_service_user
NOTIFICATION_SERVICE_DB_PASS=notification_service_pass
DOCUMENT_STORAGE_SERVICE_DB_NAME=document_storage_service_db
DOCUMENT_STORAGE_SERVICE_DB_USER=document_storage_service_user
DOCUMENT_STORAGE_SERVICE_DB_PASS=document_storage_service_pass

# RabbitMQ
RABBITMQ_USER=nexhire
RABBITMQ_PASS=nexhire
RABBITMQ_URL=amqp://nexhire:nexhire@localhost:5672
RABBITMQ_EXCHANGE=nexhire.events
AUTH_SERVICE_COMPANY_LINK_QUEUE=auth.company-link
COMPANY_SERVICE_JOB_REVIEW_TRUST_SIGNAL_QUEUE=company.job-review-trust-signal
JOB_SERVICE_COMPANY_SNAPSHOT_QUEUE=job.company-snapshot
JOB_SERVICE_APPLICATION_SUBMITTED_QUEUE=job.application-submitted
JOB_EXPIRATION_SWEEP_INTERVAL_MS=300000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Google login
# FE obtains Google ID token from Google Identity Services and sends it to auth-service.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Optional comma-separated list when FE has multiple Google OAuth clients.
GOOGLE_CLIENT_IDS=
GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo
EMAIL_VERIFICATION_TOKEN_LENGTH=6
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_RESENDS=5
PASSWORD_RESET_TOKEN_LENGTH=6
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_RESENDS=5

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexhire

# SMTP / Mailtrap
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_SECURE=false
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexHire <noreply@nexhire.vn>"
NOTIFICATION_QUEUE_EMAIL_VERIFICATION=notification.email.verification
NOTIFICATION_QUEUE_PASSWORD_RESET=notification.email.password-reset
NOTIFICATION_QUEUE_IN_APP_APPLICATION=notification.in-app.application

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
SKIMA_API_KEY=
SKIMA_BASE_URL=https://api.skima.ai
SKIMA_PARSE_PATH=/resume/parse
SKIMA_TIMEOUT_MS=30000
SKIMA_PROVIDER_VERSION=
SKIMA_PERSIST_RAW_PAYLOAD=false

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password
