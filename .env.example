# Runtime
NODE_ENV=development

# Ports
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CANDIDATE_SERVICE_PORT=3002
COMPANY_SERVICE_PORT=3003
JOB_SERVICE_PORT=3004
APPLICATION_SERVICE_PORT=3005
CV_PARSING_SERVICE_PORT=3006
MATCHING_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
DOCUMENT_STORAGE_SERVICE_PORT=3009

# Internal service URLs
AUTH_SERVICE_URL=http://localhost:3001
CANDIDATE_SERVICE_URL=http://localhost:3002
COMPANY_SERVICE_URL=http://localhost:3003
JOB_SERVICE_URL=http://localhost:3004
APPLICATION_SERVICE_URL=http://localhost:3005
CV_PARSING_SERVICE_URL=http://localhost:3006
MATCHING_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
DOCUMENT_STORAGE_SERVICE_URL=http://localhost:3009

# Database
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AUTH_SERVICE_DB_NAME=auth_service_db
AUTH_SERVICE_DB_USER=auth_service_user
AUTH_SERVICE_DB_PASS=auth_service_pass
CANDIDATE_SERVICE_DB_NAME=candidate_service_db
CANDIDATE_SERVICE_DB_USER=candidate_service_user
CANDIDATE_SERVICE_DB_PASS=candidate_service_pass
COMPANY_SERVICE_DB_NAME=company_service_db
COMPANY_SERVICE_DB_USER=company_service_user
COMPANY_SERVICE_DB_PASS=company_service_pass
JOB_SERVICE_DB_NAME=job_service_db
JOB_SERVICE_DB_USER=job_service_user
JOB_SERVICE_DB_PASS=job_service_pass
APPLICATION_SERVICE_DB_NAME=application_service_db
APPLICATION_SERVICE_DB_USER=application_service_user
APPLICATION_SERVICE_DB_PASS=application_service_pass
CV_PARSING_SERVICE_DB_NAME=cv_parsing_service_db
CV_PARSING_SERVICE_DB_USER=cv_parsing_service_user
CV_PARSING_SERVICE_DB_PASS=cv_parsing_service_pass
MATCHING_SERVICE_DB_NAME=matching_service_db
MATCHING_SERVICE_DB_USER=matching_service_user
MATCHING_SERVICE_DB_PASS=matching_service_pass
DOCUMENT_STORAGE_SERVICE_DB_NAME=document_storage_service_db
DOCUMENT_STORAGE_SERVICE_DB_USER=document_storage_service_user
DOCUMENT_STORAGE_SERVICE_DB_PASS=document_storage_service_pass

# RabbitMQ
RABBITMQ_USER=nexhire
RABBITMQ_PASS=nexhire
RABBITMQ_URL=amqp://nexhire:nexhire@localhost:5672
RABBITMQ_EXCHANGE=nexhire.events

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexhire

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexHire <noreply@nexhire.vn>"

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend
FRONTEND_URL=http://localhost:5173
