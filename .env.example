# ─────────── Runtime ───────────
NODE_ENV=development

# ─────────── Ports ───────────
GATEWAY_PORT=3000
AUTH_PORT=3001
JOB_PORT=3002
CVAPP_PORT=3003
AI_PORT=3004
NOTIF_PORT=3005

# ─────────── Internal service URLs (used by gateway + inter-service calls) ───────────
AUTH_SERVICE_URL=http://localhost:3001
JOB_SERVICE_URL=http://localhost:3002
CVAPP_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004
NOTIF_SERVICE_URL=http://localhost:3005

# ─────────── Database (one PostgreSQL instance, database-per-service) ───────────
DB_HOST=localhost
DB_PORT=5432
# Postgres superuser (compose bootstrap only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Per-service database + dedicated user (must match scripts/init-databases.sql)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass
JOB_DB_NAME=job_db
JOB_DB_USER=job_user
JOB_DB_PASS=job_pass
CVAPP_DB_NAME=cvapp_db
CVAPP_DB_USER=cvapp_user
CVAPP_DB_PASS=cvapp_pass
AI_DB_NAME=ai_db
AI_DB_USER=ai_user
AI_DB_PASS=ai_pass

# ─────────── RabbitMQ (event bus — async inter-service messaging) ───────────
RABBITMQ_USER=nexhire
RABBITMQ_PASS=nexhire
RABBITMQ_URL=amqp://nexhire:nexhire@localhost:5672
RABBITMQ_EXCHANGE=nexhire.events

# ─────────── Redis (cache + rate limit + token store) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────── JWT (separate secrets for access vs refresh) ───────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ─────────── MinIO (object storage for CV files) ───────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexhire

# ─────────── SMTP (email) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexHire <noreply@nexhire.vn>"

# ─────────── AI (Gemini) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────── Frontend ───────────
FRONTEND_URL=http://localhost:5173
