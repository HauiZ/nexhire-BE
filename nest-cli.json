{
    "$schema":  "https://json.schemastore.org/nest-cli",
    "collection":  "@nestjs/schematics",
    "sourceRoot":  "apps/gateway/src",
    "monorepo":  true,
    "root":  "apps/gateway",
    "compilerOptions":  {
                            "webpack":  true,
                            "tsConfigPath":  "apps/gateway/tsconfig.app.json",
                            "deleteOutDir":  true
                        },
    "projects":  {
                     "shared":  {
                                    "type":  "library",
                                    "root":  "packages/shared",
                                    "entryFile":  "index",
                                    "sourceRoot":  "packages/shared/src",
                                    "compilerOptions":  {
                                                            "tsConfigPath":  "packages/shared/tsconfig.lib.json"
                                                        }
                                },
                     "infra":  {
                                   "type":  "library",
                                   "root":  "packages/infra",
                                   "entryFile":  "index",
                                   "sourceRoot":  "packages/infra/src",
                                   "compilerOptions":  {
                                                           "tsConfigPath":  "packages/infra/tsconfig.lib.json"
                                                       }
                               },
                     "gateway":  {
                                     "type":  "application",
                                     "root":  "apps/gateway",
                                     "entryFile":  "main",
                                     "sourceRoot":  "apps/gateway/src",
                                     "compilerOptions":  {
                                                             "tsConfigPath":  "apps/gateway/tsconfig.app.json"
                                                         }
                                 },
                     "auth-service":  {
                                          "type":  "application",
                                          "root":  "apps/auth-service",
                                          "entryFile":  "main",
                                          "sourceRoot":  "apps/auth-service/src",
                                          "compilerOptions":  {
                                                                  "tsConfigPath":  "apps/auth-service/tsconfig.app.json"
                                                              }
                                      },
                     "candidate-service":  {
                                               "type":  "application",
                                               "root":  "apps/candidate-service",
                                               "entryFile":  "main",
                                               "sourceRoot":  "apps/candidate-service/src",
                                               "compilerOptions":  {
                                                                       "tsConfigPath":  "apps/candidate-service/tsconfig.app.json"
                                                                   }
                                           },
                     "company-service":  {
                                             "type":  "application",
                                             "root":  "apps/company-service",
                                             "entryFile":  "main",
                                             "sourceRoot":  "apps/company-service/src",
                                             "compilerOptions":  {
                                                                     "tsConfigPath":  "apps/company-service/tsconfig.app.json"
                                                                 }
                                         },
                     "job-service":  {
                                         "type":  "application",
                                         "root":  "apps/job-service",
                                         "entryFile":  "main",
                                         "sourceRoot":  "apps/job-service/src",
                                         "compilerOptions":  {
                                                                 "tsConfigPath":  "apps/job-service/tsconfig.app.json"
                                                             }
                                     },
                     "application-service":  {
                                                 "type":  "application",
                                                 "root":  "apps/application-service",
                                                 "entryFile":  "main",
                                                 "sourceRoot":  "apps/application-service/src",
                                                 "compilerOptions":  {
                                                                         "tsConfigPath":  "apps/application-service/tsconfig.app.json"
                                                                     }
                                             },
                     "cv-parsing-service":  {
                                                "type":  "application",
                                                "root":  "apps/cv-parsing-service",
                                                "entryFile":  "main",
                                                "sourceRoot":  "apps/cv-parsing-service/src",
                                                "compilerOptions":  {
                                                                        "tsConfigPath":  "apps/cv-parsing-service/tsconfig.app.json"
                                                                    }
                                            },
                     "matching-service":  {
                                              "type":  "application",
                                              "root":  "apps/matching-service",
                                              "entryFile":  "main",
                                              "sourceRoot":  "apps/matching-service/src",
                                              "compilerOptions":  {
                                                                      "tsConfigPath":  "apps/matching-service/tsconfig.app.json"
                                                                  }
                                          },
                     "notification-service":  {
                                                  "type":  "application",
                                                  "root":  "apps/notification-service",
                                                  "entryFile":  "main",
                                                  "sourceRoot":  "apps/notification-service/src",
                                                  "compilerOptions":  {
                                                                          "tsConfigPath":  "apps/notification-service/tsconfig.app.json"
                                                                      }
                                              },
                     "document-storage-service":  {
                                                      "type":  "application",
                                                      "root":  "apps/document-storage-service",
                                                      "entryFile":  "main",
                                                      "sourceRoot":  "apps/document-storage-service/src",
                                                      "compilerOptions":  {
                                                                              "tsConfigPath":  "apps/document-storage-service/tsconfig.app.json"
                                                                          }
                                              }
                 }
}
